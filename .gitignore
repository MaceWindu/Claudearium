# Claude Code per-user local state (permissions allowlist, etc.) —
# but track shared subagent definitions under .claude/agents/ and
# shared skill definitions under .claude/skills/.
.claude/*
!.claude/agents/
!.claude/skills/

# Release marker — written by CI into the zip, never committed.
VERSION

# MOTW-unblock sentinel — written at runtime by claudearium.ps1 /
# open-claudearium.ps1 to skip the recursive Unblock-File walk on
# subsequent launches.
.motw-unblocked

# Local scratch (review reports, ad-hoc notes). Not committed.
tmp/
