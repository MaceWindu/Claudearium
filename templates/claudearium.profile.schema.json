{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claudearium Profile",
  "description": "Declarative spec for claudearium. Edit and run 'reconcile' to bring the sandbox into the described state.",
  "type": "object",
  "required": ["schemaVersion", "distro"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "distro": {
      "type": "object",
      "required": ["name", "base", "installPath"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "base":        { "type": "string", "enum": ["debian-12"] },
        "installPath": { "type": "string", "minLength": 1 }
      }
    },
    "vpn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wgConfigPath": { "type": ["string", "null"] },
        "killswitch":   { "type": "boolean" },
        "routingMode":  { "type": "string", "enum": ["from-config", "all-except-lan"] },
        "lanCidr":      { "type": ["string", "null"], "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])$" }
      },
      "allOf": [
        {
          "if":   { "properties": { "routingMode": { "const": "all-except-lan" } }, "required": ["routingMode"] },
          "then": { "properties": { "lanCidr": { "not": { "const": "0.0.0.0/0" } } } }
        }
      ]
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "version": { "type": "string" }
        }
      }
    },
    "projects": {
      "description": "Each entry describes one git repository. distroProjects (default) live as bare mirrors inside the distro and sessions are distro-side worktrees. hostProjects (type='host') use a Windows-side checkout; sessions are host-side worktrees mounted into the distro and tools like pwsh/git are wrapped from the host via a per-session PATH shim. See docs/sessions.md.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name":          { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "enabled":       { "type": "boolean", "default": true, "description": "When false, reconcile tears down the project's infrastructure (mirror or per-project bin dir + all sessions) but preserves the profile entry. Re-enable to recreate everything." },
          "type":          { "type": "string", "enum": ["distro", "host"], "default": "distro" },
          "remote":        { "type": "string", "minLength": 1 },
          "hostCheckout":  { "type": "string", "minLength": 1, "description": "Required when type='host'. Windows path to the user's main checkout; session worktrees land at '<hostCheckout>-sessions/<session>'." },
          "hostShadows":   {
            "type": "array",
            "description": "Tools (e.g. 'pwsh', 'git') to wrap from the Windows host into a per-project bin dir that's prepended to PATH only for sessions of this hostProject. Names are resolved via 'where.exe <tool>.exe' first, then a built-in candidate list. Use the object form to pin a specific Windows .exe.",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["name", "windowsExe"],
                  "additionalProperties": false,
                  "properties": {
                    "name":       { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                    "windowsExe": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          },
          "defaultBranch": { "type": "string" },
          "tabColor":      { "type": ["string", "null"], "pattern": "^(#[0-9A-Fa-f]{6})?$" },
          "hostMounts":    { "$ref": "#/properties/hostMounts" },
          "hostTools":     { "$ref": "#/properties/hostTools" },
          "claudeSettings":{ "$ref": "#/properties/claudeSettings" }
        },
        "allOf": [
          {
            "if":   { "properties": { "type": { "const": "host" } }, "required": ["type"] },
            "then": { "required": ["hostCheckout"], "properties": { "hostTools": { "maxItems": 0 } } }
          },
          {
            "if":   { "not": { "properties": { "type": { "const": "host" } }, "required": ["type"] } },
            "then": { "required": ["remote"] }
          }
        ]
      }
    },
    "hostMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "guest"],
        "additionalProperties": false,
        "properties": {
          "host":    { "type": "string", "minLength": 1 },
          "guest":   { "type": "string", "pattern": "^/.+" },
          "mode":    { "type": "string", "enum": ["ro", "rw"], "default": "ro" },
          "options": { "type": "string" }
        }
      }
    },
    "hostTools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "windowsExe", "guestCommand"],
        "additionalProperties": false,
        "properties": {
          "name":         { "type": "string" },
          "windowsExe":   { "type": "string", "minLength": 1 },
          "guestCommand": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "smokeTest":    { "type": "string" }
        }
      }
    },
    "claudeSettings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model":                        { "type": "string" },
        "defaultEffort":                { "type": "string", "enum": ["low", "medium", "high", "xhigh"] },
        "theme":                        { "type": "string", "enum": ["dark", "light", "system"] },
        "autoApproveReadOnlyBash":      { "type": "boolean" },
        "autoApproveProjectWrites":     { "type": "boolean" },
        "autoApproveBuildCommands":     { "type": "boolean" },
        "claudelk":                     { "type": "boolean" },
        "claudelkEvents": {
          "type": "array",
          "items": { "type": "string", "enum": ["Stop", "Notification", "PreToolUse", "SessionStart"] }
        },
        "alwaysThinkingEnabled":        { "type": "boolean" },
        "autoUpdatesChannel":           { "type": "string", "enum": ["stable", "latest"] },
        "disableBypassPermissionsMode": { "type": "boolean" },
        "cleanupPeriodDays":            { "type": "integer", "minimum": 0 },
        "tui":                          { "type": "string", "enum": ["fullscreen", "default"] },
        "defaultShell":                 { "type": "string", "enum": ["bash", "powershell"] },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "additionalAllow":       { "type": "array", "items": { "type": "string" } },
            "additionalDeny":        { "type": "array", "items": { "type": "string" } },
            "additionalDirectories": { "type": "array", "items": { "type": "string" } },
            "defaultMode":           { "type": "string", "enum": ["default", "acceptEdits", "plan", "bypassPermissions"] }
          }
        }
      }
    },
    "claudeFile": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["host-copy", "caveman-lite", "custom-path"] },
        "path": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if":   { "properties": { "mode": { "const": "custom-path" } } },
          "then": { "required": ["path"] }
        }
      ]
    }
  }
}
